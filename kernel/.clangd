# clangd parses the real GCC-built kernel database. Remove only code-generation
# options that the installed Clang 14 frontend cannot accept; keep includes,
# macros, target architecture, language mode, and source diagnostics intact.
CompileFlags:
  Remove:
    - -mpreferred-stack-boundary=*
    - -mindirect-branch=*
    - -mindirect-branch-register
    - -mindirect-branch-cs-prefix
    - -mfunction-return=*
    - -fno-allow-store-data-races
    - -fzero-call-used-regs=*
    - -fconserve-stack
    - -fsanitize=bounds-strict
    - -mrecord-mcount
    - -ftrivial-auto-var-init=*
